# Discord Bot Token (必須)
DISCORD_TOKEN=your_bot_token_here

# コマンドプレフィックス
BOT_PREFIX=!

# ロール名設定
PENDING_ROLE_NAME=認証待ち
MEMBER_ROLE_NAME=DTMメンバー

# 承認申請を投稿するチャンネル名 (このチャンネルに承認/拒否ボタン付きで通知されます)
REQUEST_CHANNEL_NAME=認証申請

# 拒否ボタンを押した際にメンバーをKickするか (true/false)
KICK_ON_REJECT=true

# 承認時にメンバーへ送るDM ({guild_name} が使用可能。空にすると送信しません)
APPROVED_DM_MESSAGE={guild_name} で認証されました。ようこそ！

# 拒否時にメンバーへ送るDM ({guild_name} が使用可能。空にすると送信しません)
REJECTED_DM_MESSAGE={guild_name} への参加申請が承認されませんでした。

# 承認後にウェルカムメッセージを投稿するチャンネル名 (空にすると投稿しません)
WELCOME_CHANNEL_NAME=general

# ウェルカムメッセージのテンプレート ({member} と {guild} が使用可能)
WELCOME_MESSAGE_TEMPLATE={member} さん、認証お疲れ様でした！ **{guild}** へようこそ！🎉

# 保留中の承認申請の保存先
DB_PATH=data/pending.json
